{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!!dist",
      "!!coverage",
      "!!node_modules",
      "!!knowledge/curriculum",
      "!!.archify",
      "!!*.html",
      "!!benchmarks/pi-antigravity",
      "!!benchmarks/auth.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
